# Model provider: gemini | openrouter | groq | ollama
MODEL_PROVIDER=gemini

GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=helios_blocks
VECTOR_STORE=qdrant

# Retrieval (hashing/noop are the offline test defaults)
EMBEDDER=bge-m3
RERANKER=bge

# App
TENANT_DEFAULT=northwind
PRIVACY_TIER=public
API_BASE_URL=http://localhost:8000
