# Model provider: gemini | openrouter | groq | orcarouter | ollama
MODEL_PROVIDER=gemini

GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=tencent/hy4-preview-free
ORCAROUTER_REASONING_EFFORT=none
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings and reranker: ONNX via FastEmbed (no PyTorch)
EMBEDDER=fastembed
EMBEDDER_MODEL=BAAI/bge-base-en-v1.5
RERANKER=fastembed
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=helios_blocks
# Local development: memory. Hosted demo: qdrant.
VECTOR_STORE=memory

# App
TENANT_DEFAULT=northwind
PRIVACY_TIER=public
API_BASE_URL=http://localhost:8000
